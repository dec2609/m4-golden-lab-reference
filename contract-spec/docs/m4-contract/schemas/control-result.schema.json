{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orderflow:m4-contract-1.0:result",
  "title": "PROPOSED_REFERENCE_CHANGE canonical normalized result",
  "type": "object",
  "required": [
    "contract_version",
    "source_commit",
    "source_snapshot",
    "run_id",
    "artifact_subject",
    "execution_subject",
    "schema_version",
    "control_id",
    "execution_status",
    "raw_exit_code",
    "policy_verdict",
    "reason",
    "tool",
    "report",
    "execution_path",
    "wrapper_exit_code",
    "policy_exit_code"
  ],
  "properties": {
    "contract_version": {
      "const": "m4-contract-1.0"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_snapshot": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "artifact_subject": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_subject": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "source_commit",
            "source_snapshot"
          ],
          "properties": {
            "kind": {
              "const": "source"
            },
            "source_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "source_snapshot": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "digest"
          ],
          "properties": {
            "kind": {
              "const": "artifact"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "schema_version": {
      "const": "1.0"
    },
    "control_id": {
      "enum": [
        "DEPENDENCY",
        "GITLEAKS",
        "SBOM",
        "UNIT_TEST",
        "VULNERABILITY"
      ]
    },
    "execution_status": {
      "enum": [
        "SUCCESS",
        "ERROR"
      ]
    },
    "raw_exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "policy_verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "ERROR"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "report": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\).+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_path": {
      "type": "string",
      "pattern": "^(gitleaks|dependency|unit-test|sbom|vulnerability)-execution.json$"
    },
    "wrapper_exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "policy_exit_code": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "control_id": {
            "enum": [
              "DEPENDENCY",
              "GITLEAKS",
              "UNIT_TEST"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "artifact_subject": {
            "type": "null"
          },
          "execution_subject": {
            "type": "object",
            "required": [
              "kind",
              "source_commit",
              "source_snapshot"
            ],
            "properties": {
              "kind": {
                "const": "source"
              },
              "source_commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "source_snapshot": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "else": {
        "properties": {
          "artifact_subject": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "execution_subject": {
            "type": "object",
            "required": [
              "kind",
              "digest"
            ],
            "properties": {
              "kind": {
                "const": "artifact"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "policy_verdict": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "execution_status": {
            "const": "SUCCESS"
          },
          "raw_exit_code": {
            "const": 0,
            "type": "integer"
          },
          "report": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\).+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "policy_verdict": {
            "const": "ERROR"
          }
        }
      },
      "then": {
        "properties": {
          "execution_status": {
            "const": "ERROR"
          }
        }
      },
      "else": {
        "properties": {
          "execution_status": {
            "const": "SUCCESS"
          },
          "raw_exit_code": {
            "type": "integer"
          },
          "report": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\).+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
