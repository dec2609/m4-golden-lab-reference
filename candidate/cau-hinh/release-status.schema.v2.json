{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReleaseStatusSchemaV2",
  "type": "object",
  "required": [
    "schema_version",
    "source_commit",
    "artifact_sha256",
    "image_digest",
    "registry",
    "controls",
    "PRODUCTION_GATE",
    "deployment"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [2]
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "registry": {
      "type": "object",
      "required": ["image_reference", "image_digest"],
      "properties": {
        "image_reference": { "type": "string" },
        "image_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "controls": {
      "type": "object",
      "required": [
        "GITLEAKS_STATUS",
        "DEPENDENCY_STATUS",
        "UNIT_TEST_STATUS",
        "SBOM_STATUS",
        "DIGEST_STATUS",
        "COSIGN_STATUS",
        "VULNERABILITY_STATUS",
        "REGISTRY_STATUS"
      ],
      "properties": {
        "GITLEAKS_STATUS": { "type": "string", "enum": ["PASS", "FAIL"] },
        "DEPENDENCY_STATUS": { "type": "string", "enum": ["PASS", "FAIL"] },
        "UNIT_TEST_STATUS": { "type": "string", "enum": ["PASS", "FAIL"] },
        "SBOM_STATUS": { "type": "string", "enum": ["PASS", "FAIL"] },
        "DIGEST_STATUS": { "type": "string", "enum": ["PASS", "FAIL"] },
        "COSIGN_STATUS": { "type": "string", "enum": ["PASS", "FAIL"] },
        "VULNERABILITY_STATUS": { "type": "string", "enum": ["PASS", "FAIL"] },
        "REGISTRY_STATUS": { "type": "string", "enum": ["PASS", "FAIL"] }
      }
    },
    "PRODUCTION_GATE": {
      "type": "string",
      "enum": ["PASS", "BLOCKED"]
    },
    "deployment": {
      "type": "object",
      "required": [
        "READINESS_STATUS",
        "API_STATUS",
        "DEPLOYMENT_GATE",
        "ROLLBACK_STATUS"
      ],
      "properties": {
        "READINESS_STATUS": { "type": "string", "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "API_STATUS": { "type": "string", "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "DEPLOYMENT_GATE": { "type": "string", "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "ROLLBACK_STATUS": { "type": "string", "enum": ["PASS", "FAIL", "NOT_REQUIRED"] }
      }
    }
  }
}